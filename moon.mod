name = "tlhuecdkoyg/MoonEditorConfig"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/tlhuecdkoyg/MoonEditorConfig"

license = "Apache-2.0"

keywords = [ "editorconfig", "glob", "formatter", "diagnostics", "moonbit" ]

preferred_target = "native"

description = "An explainable EditorConfig core and style diagnostics toolkit for MoonBit projects."
